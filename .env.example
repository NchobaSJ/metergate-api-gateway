# ─── Postgres ────────────────────────────────────────────────
POSTGRES_USER=metergate
POSTGRES_PASSWORD=metergate
POSTGRES_DB=metergate

# ─── Gateway ─────────────────────────────────────────────────
# Inside Docker, "upstream" resolves via Docker's DNS to the
# upstream container. Never use localhost inside a container.
UPSTREAM_URL=http://upstream:4000
UPSTREAM_TIMEOUT_MS=5000
